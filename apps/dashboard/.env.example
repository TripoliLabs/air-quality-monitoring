# Dashboard environment (Vite). Copy to .env.local to override locally.
#
# Where the data comes from:
#   - `pnpm dev` with nothing set  -> the in-browser mock (no backend needed).
#   - `pnpm dev` with VITE_API_URL -> the live API at that address.
#   - a production build           -> always the live API; the mock is not in
#                                     the bundle. Defaults to same-origin /api.

# Live API for local development (the API from `docker compose up`):
# VITE_API_URL=http://localhost:3000

# Force a source while developing: `mock` or `api`. Ignored by production builds.
# VITE_DATA_SOURCE=mock

# Socket.IO server, if it is not the API's own origin:
# VITE_WS_URL=http://localhost:3000

# Map styles (MapLibre style JSON). Default: OpenFreeMap, no API key.
# VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
