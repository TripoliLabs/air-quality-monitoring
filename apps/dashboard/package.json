    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vue-tsc": "vue-tsc"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
