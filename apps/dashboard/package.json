    "maplibre-gl": "^6.12.0",
    "pinia": "^4.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
