# Air Quality Monitoring - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# Relational app database (normal PostgreSQL)
# Users, auth, API keys, sensor/device metadata, locations, dashboard config.
# Also backs ChirpStack. Kept separate from telemetry.
# =============================================================================
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USERNAME=airquality
APP_DB_PASSWORD=airquality
APP_DB_NAME=airquality

# =============================================================================
# Telemetry database (dedicated TimescaleDB instance)
# Time-series sensor readings only: hypertables, continuous aggregates,
# compression + retention.
# =============================================================================
TSDB_HOST=localhost
TSDB_PORT=5439
TSDB_USERNAME=airquality
TSDB_PASSWORD=airquality
TSDB_NAME=telemetry

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# MQTT (EMQX Serverless or self-hosted)
# =============================================================================
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# For EMQX Serverless:
# MQTT_URL=mqtts://your-instance.emqxsl.com:8883
# MQTT_USERNAME=your-username
# MQTT_PASSWORD=your-password

# =============================================================================
# ChirpStack
# =============================================================================
CHIRPSTACK_URL=http://localhost:8080
CHIRPSTACK_API_TOKEN=

# =============================================================================
# Frontend
# =============================================================================
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# =============================================================================
# Monitoring
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# =============================================================================
# LoRaWAN Keys (NEVER commit real keys!)
# =============================================================================
# These are placeholders - generate your own keys
# LORAWAN_APP_EUI=0000000000000000
# LORAWAN_APP_KEY=00000000000000000000000000000000
