{
  "name": "air-quality-monitoring",
  "version": "0.1.0",
  "description": "Distributed Air Quality Monitoring Network for Tripoli, Lebanon",
  "author": "TripoliLabs",
  "license": "AGPL-3.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "prepare": "lefthook install || true",
    "build": "turbo run build",
